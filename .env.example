# PickyHoliday provider foundation defaults to mock mode.
# Modes: mock | duffel | amadeus | hybrid
TRAVEL_PROVIDER_MODE=mock
VITE_TRAVEL_PROVIDER_MODE=mock
TRAVEL_PRIMARY_FLIGHT_PROVIDER=duffel
ENABLE_AMADEUS_SECONDARY=false
# Leave blank for same-origin /api routes. Vite dev proxies /api to http://localhost:8787.
VITE_API_BASE_URL=
VITE_SHOW_PROVIDER_DIAGNOSTICS=false

# Duffel is the preferred future flight provider path.
# Use a Duffel test token only in local/dev; test tokens usually start with duffel_test_.
# Keep DUFFEL_ACCESS_TOKEN server-side only and never expose it through VITE_* browser env vars.
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2

# Amadeus remains an optional sandbox/search provider. Do not commit real credentials.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_CURRENCY=GBP
AMADEUS_DEFAULT_DEPARTURE_DATE=
AMADEUS_DEFAULT_ADULTS=2
AMADEUS_DEFAULT_NIGHTS=7

# Enquiry persistence, promoted deal storage, site config and admin review.
# Keep ENQUIRY_STORAGE_MODE=json until Postgres support is deployed.
# JSON storage is temporary and writes to data/enquiries.json on the server runtime.
# Set ENQUIRY_STORAGE_MODE=postgres only after DATABASE_URL is set.
# On Railway, DATABASE_URL should reference the PostgreSQL service variable.
# Do not expose DATABASE_URL to VITE_* variables or browser code.
ENQUIRY_STORAGE_MODE=json
# JSON modes are safe fallbacks; Postgres modes require DATABASE_URL and should stay server-side only.
PROMOTED_DEAL_STORAGE_MODE=json
SITE_CONFIG_STORAGE_MODE=json
CONTENT_PAGE_STORAGE_MODE=json
PUBLIC_SITE_URL=https://pickyholiday.co.uk
DATABASE_URL=
ADMIN_ACCESS_TOKEN=
# Temporary non-live dashboard access. Disable before production launch or set ADMIN_ACCESS_TOKEN.
ENABLE_TEST_ADMIN_LOGIN=true
TEST_ADMIN_ACCESS_TOKEN=pickyholiday-test-admin
ALLOW_UNPROTECTED_ADMIN=false
ENQUIRY_NOTIFY_EMAIL=

# Future hotel/payment provider placeholders only.
EXPEDIA_RAPID_API_KEY=
EXPEDIA_RAPID_SECRET=
STRIPE_SECRET_KEY=

# Package/affiliate placeholders.
# Keep real IDs server-side unless a partner explicitly approves client-side tracking.
# These are placeholders only and should be replaced only after approved partner/affiliate setup.
AFFILIATE_PROVIDER_MODE=mock
AFFILIATE_DEFAULT_TRACKING_ID=
SKYSCANNER_AFFILIATE_ID=
EXPEDIA_AFFILIATE_ID=
TUI_AFFILIATE_ID=
EASYJET_HOLIDAYS_AFFILIATE_ID=
JET2HOLIDAYS_AFFILIATE_ID=
LOVEHOLIDAYS_AFFILIATE_ID=
ONTHEBEACH_AFFILIATE_ID=

# Lightweight analytics and admin operations centre.
# JSON analytics is a fallback only and writes to data/analytics-events.json at runtime.
# Set ANALYTICS_STORAGE_MODE=postgres only when DATABASE_URL is configured server-side.
ANALYTICS_STORAGE_MODE=json
PUBLIC_ANALYTICS_ENABLED=true
# Admin-only webhook tester. Do not include secrets in test payloads.
# An allowlist is recommended in production; values are hostnames only, comma-separated.
WEBHOOK_TEST_ALLOWED_HOSTS=
WEBHOOK_TEST_TIMEOUT_MS=5000
